{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist/server",
    "rootDir": "./server/src",
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server/src/**/*.ts"]
}