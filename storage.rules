rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // LMS training content and thumbnails are uploaded server-side (Firebase Admin SDK)
    // and made public via makePublic(). These rules allow browsers to read them directly.
    match /lms-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Writes go through the server API only.
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
