{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "dist/functions-staging",
    "runtime": "nodejs22",
    "ignore": [
      ".git",
      ".git/**"
    ],
    "predeploy": [
      "npm run firebase:functions:build"
    ]
  },
  "hosting": {
    "public": "dist/lms-app/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "api{,/**}",
        "function": "api"
      },
      {
        "source": "tenant-api{,/**}",
        "function": "tenantApi"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
