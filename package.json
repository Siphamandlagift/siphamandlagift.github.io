{
  "type": "module",
  "main": "dist/firebase/server/src/index.js",
  "name": "lms-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "firebase:functions:build": "tsc -p tsconfig.firebase.json && node generate-manifest.mjs && node setup-functions-staging.mjs",
    "deploy": "ng build && firebase deploy",
    "deploy:hosting": "ng build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "server:dev": "tsx watch server/src/server.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/server/server.js",
    "tenant:server:dev": "tsx watch server/src/multitenant-server.ts",
    "tenant:server:build": "tsc -p tsconfig.server.json",
    "tenant:server:start": "node dist/server/multitenant-server.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "fflate": "^0.8.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.5.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
